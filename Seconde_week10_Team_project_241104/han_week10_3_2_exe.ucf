#2021041091 2학년 3반 한규철 2021041089 최태민 10주차 팀과제 3 - 1 동기식 리셋 8진 카운터 응용 ucf

#input 
net "clk" loc = c9;  #clk
net "rst" loc = j12; #ev3

#input load
net "load" loc = j14; #ev2

#output - beep
net "beep" loc = e11; #buzzer

#ouput - pwm
net "pwm_led(0)" loc = d12; #r
net "pwm_led(1)" loc = d9;  #g
net "pwm_led(2)" loc = c11; #b

#output - team3(event)
net "team3(0)" loc = b12; #y7
net "team3(1)" loc = a14; #y6
net "team3(2)" loc = a12; #y5
net "team3(3)" loc = f7;  #y4
net "team3(4)" loc = e7;  #y3
net "team3(5)" loc = d8;  #y2
net "team3(6)" loc = d5;  #y1
net "team3(7)" loc = c7;  #y0

#output - q
net "q(0)" loc = a13; #tr1
net "q(1)" loc = b14; #tr2
net "q(2)" loc = c13; #tr3
net "q(3)" loc = d11; #tr4

#output - 7segment
net "seg(0)" loc = a8; #a
net "seg(1)" loc = b8; #b
net "seg(2)" loc = c6; #c
net "seg(3)" loc = c8; #d
net "seg(4)" loc = d6; #e
net "seg(5)" loc = e6; #f 
net "seg(6)" loc = a9; #g
net "seg(7)" loc = a11; #dp